BOT_TOKEN=
ADMIN_USER_ID=

# AI 接口（至少一个）
AI_POOL_1=https://api.openai.com/v1|sk-xxx|gpt-4o-mini

# 授权开关：1=开启，0=关闭
AUTH_REQUIRED=1
# 允许使用机器人的 TGID（逗号分隔）
AUTHORIZED_USER_IDS=
# 可选：授权校验接口（POST JSON），配置后启动时强校验
AUTH_SERVER_URL=
AUTH_LICENSE_KEY=
# 允许管理员在 TG 私聊执行 /update check|now
ENABLE_TG_UPDATE=1

# 可选：Webhook 模式
WEBHOOK_URL=
WEBHOOK_SECRET=
